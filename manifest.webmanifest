{
  "id": "/home",
  "name": "AnivoidTV",
  "short_name": "AnivoidTV",
  "description": "Watch anime free: schedule, top charts, your watch list, profile effects and sticker comments.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/home?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f0e13",
  "theme_color": "#0f0e13",
  "categories": ["entertainment", "video"],
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Latest episodes", "short_name": "Latest", "url": "/home?source=shortcut", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Schedule", "short_name": "Schedule", "url": "/home?source=shortcut#schedule", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My profile", "short_name": "Profile", "url": "/profile?source=shortcut", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Void Shop", "short_name": "Shop", "url": "/shop?source=shortcut", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
